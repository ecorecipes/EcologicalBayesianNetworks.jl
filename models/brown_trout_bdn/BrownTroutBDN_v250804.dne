	probs = 
		// 0 to <1      1 to <2      >= 2          // InHabRest     BankStab      
		  (0.2,         0.8,         0,            // Not implement Not implement 
		   0.15,        0.75,        0.1,          // Not implement Implement     
		   0.15,        0.75,        0.1,          // Implement     Not implement 
		   0.1,         0.7,         0.2);         // Implement     Implement     ;
	title = "Weighted Usable Area m2/m";
	comment = "Weighted usable area (WUA) is a metric used to \n\
		characterize stream habitat suitability for aquatic \n\
		organisms. Two-dimensional hydrodynamic modelling \n\
		was used by Richer et al. 2019 to estimate WUA for \n\
		adult, juvenile, fry, and spawning brown trout across \n\
		a range of flows in the upper Arkansas River. We \n\
		used the least-square mean (lsmean) values of WUA \n\
		reported by Richer et al. 2019. The WUA state values \n\
		we chose bracket the lsmean WUA values observed \n\
		in the UAR before and after habitat restoration.  ";
	whenchanged = 1722531945;
	belief = (0.1, 0.7, 0.2);
	visual V2 {
		center = (372, 552);
		height = 1;
		link 2 {
			path = ((741, 665), (495, 589));
			};
		};
	};

node BrnTroutForag {
	discrete = FALSE;
	statetitles = ("0 to <0.5", "0.5  to <1", ">=1");
	levels = (0, 0.5, 1, 2);
	kind = NATURE;
	chance = CHANCE;
	parents = (InHabRest);
	probs = 
		// 0 to <0.5    0.5  to <1   >=1           // InHabRest     
		  (0.5,         0.4,         0.1,          // Not implement 
		   0.25,        0.5,         0.25);        // Implement     ;
	title = "Brown Trout Foraging Position n/m";
	comment = "Foraging positions (FP) are defined as locations within \n\
		streams that trout may use to optimize the energy spent \n\
		swimming, maintaining position, and searching for prey \n\
		while maximizing encountering and consuming prey \n\
		resources. Richer et al. 2019 estimated foraging position \n\
		using fish length, weight, focal point velocity, capture \n\
		area velocity, foraging radius, and minimum depth. \n\
		Foraging position is expressed as the number of fish \n\
		per stream meter. We bracket changes in FP \n\
		before and after restoration in the UAR.";
	whenchanged = 1722532099;
	belief = (0.25, 0.5, 0.25);
	visual V2 {
		center = (1068, 552);
		height = 3;
		};
	};

