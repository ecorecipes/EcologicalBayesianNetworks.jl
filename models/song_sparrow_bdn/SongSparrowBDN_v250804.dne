	probs = 
		// 0 to <5      5 to <10     10 to <15    >= 15        
		  (0.3,         0.5,         0.2,         0);
	title = "Pre-Restoration Song Sparrow Density (n/acre)";
	comment = "Values and distribution of Song Sparrow adults per acre\n\
		from hypothetical site; Song Sparrow densities are based on reported \n\
		pre and post restoration density from montaine riparian \n\
		meadows in California (Campos et al. 2020) and the Central \n\
		Valley, CA (Dybala et al. 2018). We chose to model adults\n\
		because nest success is highly variable and around 19%,\n\
		so adults represent true contribution to population.";
	whenchanged = 1754312895;
	belief = (0.3, 0.5, 0.2, 0);
	visual V1 {
		center = (720, 324);
		height = 3;
		};
	};

